  «text (15600,4200) 1 7 0 0x1000000 -1 -1 "ï»¿.param I1=2.592 I2=3.168 Vs=4.006 Vc=3.168 Ig=2.592 Vo=3.168"»
  «text (15600,4500) 1 7 1 0x1000000 -1 -1 "ï»¿.DC OPERATING POINT"»
  «text (10100,2050) 1 7 0 0x1000000 -1 -1 "ï»¿.param A11= - ( ( r1+(rs+rc1)*(1-D) )/L1 ) A12= - rc1*(1-D)/L1  A13= -(1-D)/L1  A14= -( R/(R+rc) )*(1-D)/L1"»
  «text (10100,1750) 1 7 0 0x1000000 -1 -1 "ï»¿.param B11= 1/L1  B12= (  (rs+rc1)*I1 + rc1*I2 + Vs + R*Vc/(R+rc) + rc1*Io  )/L1   B13= -rc1*(1-D)/L1"»
  «text (10000,250) 1 7 0 0x1000000 -1 -1 "ï»¿.param A21= -rc1*(1-D)/L2   A22= -( r2+rs*D+rc1*(1-D) )/L2   A23= D/L2  A24= -(rc1/rc)*(1-D)/L2"»
  «text (10050,-50) 1 7 0 0x1000000 -1 -1 "ï»¿.param B21=0  B22= ( rc*I1 + (rc1-rs)*I2 + Vs + rc1*Vc/rc + rc1*Io  )/L2     B23= -rc1*(1-D)/L2"»
  «text (10050,-1550) 1 7 0 0x1000000 -1 -1 "ï»¿.param A31= (1-D)/Cs   A32= -D/Cs   A33=0   A34=0"»
  «text (10050,-1800) 1 7 0 0x1000000 -1 -1 "ï»¿.param B31=0  B32=-(I1+I2)/Cs  B33=0"»
